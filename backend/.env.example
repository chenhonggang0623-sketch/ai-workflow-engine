# === LLM (optional — fallback planner works fully offline) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini

# === Execution provider (default for every planned node) ===
AGENT_DEFAULT_PROVIDER=opencode_cli
OPENCODE_PATH=opencode
CLAUDE_CODE_PATH=claude
CODEX_PATH=codex

# === Infrastructure ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_workflow
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# === Node intervention ===
SLOW_NODE_AFTER_SECONDS=300